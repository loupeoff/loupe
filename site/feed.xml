  <item>
    <title>EN DIRECT, guerre en Ukraine : nouvelles frappes russes dans la nuit, au moins cinq morts à Zaporijia</title>
    <link>https://www.lemonde.fr/international/live/2026/08/11/en-direct-guerre-en-ukraine-nouvelles-frappes-russes-sur-kiev_6741928_3210.html</link>
    <guid isPermaLink="true">https://www.lemonde.fr/international/live/2026/08/11/en-direct-guerre-en-ukraine-nouvelles-frappes-russes-sur-kiev_6741928_3210.html</guid>
    <pubDate>Tue, 11 Aug 2026 00:32:37 +0000</pubDate>
    <category>International</category>
